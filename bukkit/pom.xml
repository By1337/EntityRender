<project xmlns="http://maven.apache.org/POM/4.0.0" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
    <modelVersion>4.0.0</modelVersion>
    <parent>
        <groupId>dev.by1337.entityrender</groupId>
        <artifactId>EntityRender</artifactId>
        <version>2.0.0+26.3</version>
    </parent>
    <artifactId>bukkit</artifactId>
    <version>2.0.0</version>
    <dependencies>
        <dependency>
            <groupId>dev.by1337.core</groupId>
            <artifactId>BLibV2</artifactId>
            <version>1.10.8</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>dev.by1337.bpatch</groupId>
            <artifactId>bpatch-runtime</artifactId>
            <version>1.0.0</version>
            <scope>provided</scope>
        </dependency>
        <dependency>
            <groupId>io.papermc.paper</groupId>
            <artifactId>paper-api</artifactId>
            <version>1.21.4-R0.1-SNAPSHOT</version>
            <scope>provided</scope>
        </dependency>
    </dependencies>
    <repositories>
        <repository>
            <id>bdev-repo</id>
            <url>https://repo.by1337.space/releases</url>
        </repository>
        <repository>
            <id>papermc</id>
            <url>https://repo.papermc.io/repository/maven-public/</url>
        </repository>
    </repositories>
    <pluginRepositories>
        <pluginRepository>
            <id>bdev-repo</id>
            <url>https://repo.by1337.space/releases</url>
        </pluginRepository>
    </pluginRepositories>
    <build>
        <finalName>EntityRender-${project.version}</finalName>
        <resources>
            <resource>
                <directory>src/main/resources</directory>
                <filtering>true</filtering>
            </resource>
        </resources>
        <plugins>
            <plugin>
                <groupId>dev.by1337.bpatch</groupId>
                <artifactId>bpatch-maven-plugin</artifactId>
                <version>1.0.0</version>
                <executions>
                    <execution>
                        <id>pack-versioned-runtime</id>
                        <goals><goal>pack</goal></goals>
                    </execution>
                </executions>
                <configuration>
                    <patchSets>
                        <patchSet>
                            <output>runtime/api.zip</output>
                            <compression>STORED</compression>
                            <mode>CHAIN</mode>
                            <excludeMetaInf>true</excludeMetaInf>
                            <versions>
                                <version>
                                    <id>1.21.4</id>
                                    <artifact>dev.by1337.entityrender:entity-render-api:2.0.0+1.21.4</artifact>
                                </version>
                                <version>
                                    <id>1.21.5</id>
                                    <artifact>dev.by1337.entityrender:entity-render-api:2.0.0+1.21.5</artifact>
                                </version>
                                <version>
                                    <id>1.21.6</id>
                                    <artifact>dev.by1337.entityrender:entity-render-api:2.0.0+1.21.6</artifact>
                                </version>
                                <version>
                                    <id>1.21.7</id>
                                    <artifact>dev.by1337.entityrender:entity-render-api:2.0.0+1.21.7</artifact>
                                </version>
                                <version>
                                    <id>1.21.8</id>
                                    <artifact>dev.by1337.entityrender:entity-render-api:2.0.0+1.21.8</artifact>
                                </version>
                                <version>
                                    <id>1.21.9</id>
                                    <artifact>dev.by1337.entityrender:entity-render-api:2.0.0+1.21.9</artifact>
                                </version>
                                <version>
                                    <id>1.21.10</id>
                                    <artifact>dev.by1337.entityrender:entity-render-api:2.0.0+1.21.10</artifact>
                                </version>
                                <version>
                                    <id>1.21.11</id>
                                    <artifact>dev.by1337.entityrender:entity-render-api:2.0.0+1.21.11</artifact>
                                </version>
                                <version>
                                    <id>26.1.2</id>
                                    <artifact>dev.by1337.entityrender:entity-render-api:2.0.0+26.1.2</artifact>
                                </version>
                                <version>
                                    <id>26.2</id>
                                    <artifact>dev.by1337.entityrender:entity-render-api:2.0.0+26.2</artifact>
                                </version>
                                <version>
                                    <id>26.3</id>
                                    <artifact>dev.by1337.entityrender:entity-render-api:2.0.0+26.3</artifact>
                                </version>
                            </versions>
                        </patchSet>
                        <patchSet>
                            <output>runtime/core.zip</output>
                            <compression>STORED</compression>
                            <mode>CHAIN</mode>
                            <excludeMetaInf>true</excludeMetaInf>
                            <versions>
                                <version>
                                    <id>1.21.4</id>
                                    <artifact>dev.by1337.entityrender:entity-render-core:2.0.0+1.21.4</artifact>
                                </version>
                                <version>
                                    <id>1.21.5</id>
                                    <artifact>dev.by1337.entityrender:entity-render-core:2.0.0+1.21.5</artifact>
                                </version>
                                <version>
                                    <id>1.21.6</id>
                                    <artifact>dev.by1337.entityrender:entity-render-core:2.0.0+1.21.6</artifact>
                                </version>
                                <version>
                                    <id>1.21.7</id>
                                    <artifact>dev.by1337.entityrender:entity-render-core:2.0.0+1.21.7</artifact>
                                </version>
                                <version>
                                    <id>1.21.8</id>
                                    <artifact>dev.by1337.entityrender:entity-render-core:2.0.0+1.21.8</artifact>
                                </version>
                                <version>
                                    <id>1.21.9</id>
                                    <artifact>dev.by1337.entityrender:entity-render-core:2.0.0+1.21.9</artifact>
                                </version>
                                <version>
                                    <id>1.21.10</id>
                                    <artifact>dev.by1337.entityrender:entity-render-core:2.0.0+1.21.10</artifact>
                                </version>
                                <version>
                                    <id>1.21.11</id>
                                    <artifact>dev.by1337.entityrender:entity-render-core:2.0.0+1.21.11</artifact>
                                </version>
                                <version>
                                    <id>26.1.2</id>
                                    <artifact>dev.by1337.entityrender:entity-render-core:2.0.0+26.1.2</artifact>
                                </version>
                                <version>
                                    <id>26.2</id>
                                    <artifact>dev.by1337.entityrender:entity-render-core:2.0.0+26.2</artifact>
                                </version>
                                <version>
                                    <id>26.3</id>
                                    <artifact>dev.by1337.entityrender:entity-render-core:2.0.0+26.3</artifact>
                                </version>
                            </versions>
                        </patchSet>
                    </patchSets>
                </configuration>
            </plugin>
            <plugin>
                <groupId>org.apache.maven.plugins</groupId>
                <artifactId>maven-jar-plugin</artifactId>
                <configuration>
                    <archive>
                        <manifestEntries>
                            <paperweight-mappings-namespace>mojang</paperweight-mappings-namespace>
                        </manifestEntries>
                    </archive>
                </configuration>
            </plugin>
        </plugins>
    </build>
</project>
